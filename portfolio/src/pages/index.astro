
---
import "../styles/global.css";

import entrenamiento from "../imagenes/entrenamiento.jpeg";
import sha from "../imagenes/sha.jpeg";
import lamroth from "../imagenes/lamroth.jpeg";
import penal from "../imagenes/penal.jpeg";
import fotomedalla from "../imagenes/fotoMedalla.jpeg";
import madrij from "../imagenes/madrij.jpeg";
import insign from "../imagenes/insign.jpeg";
import fotoMia from "../imagenes/fotoMia.jpeg";

const photos = [
  ["EL DESAFÍO", penal, "Un momento de aprendizaje en la cancha"],
  ["LA PREPARACIÓN", entrenamiento, "Entrenamiento y esfuerzo"],
  ["LOS LOGROS", fotomedalla, "Un logro y un recuerdo especial"],
  ["COMPARTIR", lamroth, "Compartir momentos con el equipo"],
  ["EL EQUIPO", sha, "Trabajo en equipo"],
];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#fdfdfb" />
  <meta name="description" content="Portfolio personal: fútbol, educación no formal y proyectos escolares." />
  <title>Portfolio | Thiago Yusefoff</title>
</head>

<body>
  <header class="site-header">
    <nav class="container nav-inner" aria-label="Navegación principal">
      <a class="brand" href="#inicio">THIAGO YUSEFOFF / PORTFOLIO</a>

      <div class="nav-links">
        <a href="#inicio">INICIO</a>
        <a href="#futbol">FÚTBOL</a>
        <a href="#educacion">EDUCACIÓN</a>
        <a href="#escuela">ESCUELA</a>
        <a href="#contacto">CONTACTO</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- INICIO -->
    <section class="hero" id="inicio">
      <div class="container hero-content">

        <div class="hero-text">
          <h1>El equipo primero.<br />Siempre seguir adelante.</h1>
          <p>Futbolista · Educador en formación · Estudiante</p>
        </div>

        <div class="hero-photo">
          <img
            src={fotoMia.src}
            alt="Retrato personal"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>

    <!-- FÚTBOL -->
    <section class="football" id="futbol">
      <div class="container">
        <div class="football-intro">
          <h2>FÚTBOL Y EQUIPO</h2>
          <h3>Nunca dejar de intentar.</h3>
          <p>
            En la cancha aprendí que los errores no definen el camino:
            lo importante es seguir intentando y aportar al equipo.
          </p>
        </div>

        <h2 class="section-title gallery-title">MOMENTOS EN LA CANCHA</h2>

        <div class="gallery">
          {photos.map(([label, src, description], index) => (
            <figure class="photo-card">
              <img
                class:list={{
                  "photo-contain": index === 1 || index === 2
                }}
                src={src.src}
                alt={description}
                loading="lazy"
              />

              <figcaption>
                <small>{label}</small>
                <span>{description}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="story">
          <p>
            Empecé de chico en otro equipo, pero mi objetivo siempre fue el mismo:
            aportar para que al equipo le vaya bien. Tuve fracasos y también
            buenos momentos, pero en ninguno cambié mi manera de pensar.
            Aprendí a no rendirme y a poner los resultados colectivos por
            delante de cualquier reconocimiento individual.
          </p>
        </div>
      </div>
    </section>

    <!-- EDUCACIÓN NO FORMAL -->
    <section class="education" id="educacion">
      <div class="container">
        <h2 class="section-title">EDUCACIÓN NO FORMAL</h2>

        <div class="education-grid">
          <article class="education-main">
            <div>
              <h3>Jugar y aprender al mismo tiempo.</h3>
              <p>
                Trabajé con chicos de sala de 4 años, 1.º, 3.º y 6.º grado.
                En cada grupo propuse actividades para jugar y aprender a la vez,
                adaptándome a distintas edades. Todavía estoy aprendiendo
                y creciendo como educador.
              </p>
            </div>

            <img
              class="education-photo"
              src={madrij.src}
              alt="Experiencia como educador en educación no formal"
              loading="lazy"
            />
          </article>

          <aside class="groups-card">
            <h3>GRUPOS CON LOS QUE TRABAJÉ</h3>
            <ul>
              <li>Sala de 4 años</li>
              <li>Primer grado</li>
              <li>Tercer grado</li>
              <li>Sexto grado</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- ESCUELA -->
    <section class="school" id="escuela">
      <div class="container">
        <h2 class="section-title">ANTECEDENTES ESCOLARES</h2>

        <div class="school-grid">
          <article class="school-card">
            <h3>Tres años, tres proyectos.</h3>
            <p>
              Durante tres años participé en proyectos diferentes.
              Aprendí a organizarme, trabajar en equipo y asumir cada
              propuesta con más responsabilidad.
            </p>
          </article>

          <article class="projects-card insign-card">
            <div class="insign-copy">
              <h3>Ideas que se convierten en proyectos.</h3>

              <p>
                Cada proyecto fue una oportunidad para transformar ideas
                en algo concreto. El actual nace de una idea que nos
                entusiasma y del trabajo compartido.
              </p>

              <p>
                Este año desarrollé InSign, un proyecto que busca crear
                un recurso para que los chicos aprendan a comunicarse
                mediante la Lengua de Señas Argentina (LSA) desde edades
                tempranas. La idea es facilitar la comunicación y la
                interacción con otras personas, ayudando a evitar barreras
                que puedan dificultar su socialización en el futuro.
              </p>
            </div>

            <div class="insign-image-wrap">
              <img
                src={insign.src}
                alt="Proyecto escolar InSign"
                loading="lazy"
              />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- PILARES -->
    <section class="pillars" aria-label="Mis tres pilares">
      <div class="container pillar-grid">
        <article class="pillar">
          <h3>FÚTBOL</h3>
          <p>Aprender a perseverar y priorizar al equipo.</p>
        </article>

        <article class="pillar">
          <h3>EDUCACIÓN</h3>
          <p>Usar el juego para incluir, compartir y aprender.</p>
        </article>

        <article class="pillar">
          <h3>ESCUELA</h3>
          <p>Convertir ideas en proyectos con responsabilidad.</p>
        </article>
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="contact" id="contacto">
      <div class="container">
        <h2>Los próximos desafíos<br />se construyen en equipo.</h2>

        <p>
          Estoy abierto a nuevos desafíos, aprendizajes y proyectos
          construidos en comunidad.
        </p>

        <div class="contact-links">
          <h3>CONTACTO</h3>
          <a href="mailto:thiagoyusefoff@icloud.com">
            thiagoyusefoff@icloud.com
          </a>
        </div>
      </div>
    </section>
  </main>
</body>
</html>

<style>
  .insign-card {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 38%);
    align-items: center;
    gap: 32px;
  }

  .insign-copy {
    min-width: 0;
  }

  .insign-image-wrap {
    width: 100%;
    height: 440px;
    overflow: hidden;
    border-radius: 14px;
  }

  .insign-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 68%;
    border-radius: 14px;
  }

  @media (max-width: 680px) {
    .insign-card {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .insign-image-wrap {
      width: 100%;
      height: auto;
      max-height: 480px;
      aspect-ratio: 4 / 5;
    }
  }
</style>
